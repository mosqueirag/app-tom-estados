# Copiá este archivo como .env y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API).
#
# SOLO van claves públicas. La clave service_role NUNCA va acá ni en Netlify:
# vive únicamente en las Edge Functions de Supabase.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Dominio interno para operadores que ingresan con "nombre de usuario" en vez
# de email. Tiene que ser igual a DOMINIO_USUARIOS de las Edge Functions.
VITE_DOMINIO_USUARIOS=usuarios.lecturas.app

# Clave pública VAPID para los avisos push al celular del operador.
# La clave privada NO va acá: está guardada en la tabla configuracion_push de
# Supabase, que solo puede leer la Edge Function asignar-cuentas.
VITE_VAPID_PUBLIC_KEY=
